#!/bin/sh
# Тест «реестр не смог записаться после спавна» может убить нас SIGKILL почти
# сразу после spawn() — быстрее, чем успевает стартовать интерпретатор Node
# (writeFileSync внутри fake-dsh.js мог не успеть выполниться). exec НЕ меняет
# pid, только образ процесса — поэтому пишем pid здесь, на уровне shell,
# который стартует на порядки быстрее.
if [ -n "$FAKE_PIDFILE" ]; then
  echo $$ > "$FAKE_PIDFILE" 2>/dev/null || true
fi
exec node "$(dirname "$0")/../fake-dsh.js" "$@"
