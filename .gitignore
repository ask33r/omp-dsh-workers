# No leading slash: in a git worktree this is a symlink to the main tree's
# node_modules (a fresh worktree contains only tracked files, so dependencies
# are linked into it), while a pattern with a slash only matches a real
# directory and used to leave the symlink untracked.
node_modules

# Full runtime state of runs: registry, logs, envelopes, steer channels and
# their offset files. Extension-based ignore patterns used to miss var/runs/**.
tools/dsh-bridge/var/

# Local reviewer state (codex-review / cdxfork-review / pi-review skills)
.codex-review/
.cdxfork-review/
.pi-review/

# Local HTML reports; not shipped in the repo
reports/

# Generated project-memory file (regenerated by tooling; holds local notes/paths)
CONTEXT.md

# Site-specific operational notes for the author's own environment (CodeMachine
# toolchain): kept locally, not part of the published tree.
docs/site/
